[Unit]
Description=Ironcore Next.js Web Dashboard
After=network.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/.openclaw/workspace/Ironcore-web
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=/etc/ironcore-web.env
ExecStartPre=/usr/bin/test -f /home/openclaw/.openclaw/workspace/Ironcore-web/.next/BUILD_ID
ExecStartPre=/usr/bin/test -f /home/openclaw/.openclaw/workspace/Ironcore-web/.next/server/middleware-manifest.json
ExecStartPre=/usr/bin/test -f /home/openclaw/.openclaw/workspace/Ironcore-web/.next/prerender-manifest.json
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
