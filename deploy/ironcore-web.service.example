[Unit]
Description=Ironcore Next.js Web Dashboard
After=network.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/.openclaw/workspace/Ironcore-web
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=/etc/ironcore-web.env
ExecStartPre=/home/openclaw/.openclaw/workspace/Ironcore-web/scripts/ensure-next-artifacts.sh
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
